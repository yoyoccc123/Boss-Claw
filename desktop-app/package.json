{
  "name": "bossclaw-desktop",
  "version": "2.5.49",
  "description": "BossClaw —— 面向求职者的本地 AI 投递助手",
  "private": true,
  "author": "YanQuan",
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite build && electron . --dev",
    "typecheck": "tsc -b --pretty",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "package": "node scripts/release.mjs --target dir --install",
    "package:portable": "node scripts/release.mjs --target portable --install",
    "package:dir": "node scripts/release.mjs --target dir --install",
    "package:mac": "node scripts/release.mjs --platform mac --target default",
    "package:linux": "node scripts/release.mjs --platform linux --target default",
    "start": "electron .",
    "verify": "node scripts/release.mjs --check",
    "test:theme-vars": "node scripts/theme-vars-regression.mjs",
    "test:context-budget": "node scripts/context-budget-regression.mjs",
    "test:tailor-job": "node scripts/tailor-job-regression.mjs",
    "test:resume": "node scripts/resume-regression.mjs",
    "test:resume-facts": "node scripts/resume-facts-regression.mjs",
    "test:tailor-batch": "node scripts/tailor-batch-regression.mjs",
    "test:workbench-filters": "node scripts/workbench-filters-regression.mjs",
    "test:liepin-im": "node scripts/liepin-im-regression.mjs",
    "test:tailor-iteration": "node scripts/tailor-iteration-regression.mjs",
    "test:resume-variants": "node scripts/resume-variants-regression.mjs",
    "test:zhaopin-link": "node scripts/zhaopin-link-regression.mjs",
    "test:delivery-stop": "node scripts/delivery-stop-regression.mjs",
    "test:zhaopin-block": "node scripts/zhaopin-block-regression.mjs",
    "test:zhaopin-greeting": "node scripts/zhaopin-greeting-regression.mjs",
    "test:collection-goal": "node scripts/collection-goal-regression.mjs",
    "package:nsis": "node scripts/release.mjs --target nsis --install",
    "release:check": "node scripts/release.mjs --check",
    "test:collection-resume": "node scripts/collection-resume-regression.mjs",
    "test:boss-chat": "node scripts/boss-chat-regression.mjs",
    "test:release-policy": "node scripts/release-policy-regression.mjs",
    "test:browser-navigation": "node scripts/browser-navigation-regression.mjs",
    "test:wuba": "node scripts/wuba-regression.mjs"
  },
  "build": {
    "appId": "com.bossclaw.desktop",
    "productName": "BossClaw",
    "copyright": "Copyright © 2026 BossClaw",
    "icon": "resources/icon.ico",
    "afterPack": "build/after-pack-win-icon.js",
    "publish": null,
    "asar": true,
    "directories": {
      "output": "E:/BossClaw-build/releases/${version}",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "skills/**/*",
      "resources/**/*",
      "package.json",
      "!**/*.pyc",
      "!**/__pycache__",
      "!**/.venv/**"
    ],
    "extraResources": [
      {
        "from": "electron/preload/wuba-categories.json",
        "to": "camoufox/platforms/wuba-categories.json"
      },
      {
        "from": "electron/preload/wuba.cjs",
        "to": "camoufox/platforms/wuba-dom.cjs"
      },
      {
        "from": "resources/docs/使用前必读.md",
        "to": "docs/使用前必读.md"
      },
      {
        "from": "camoufox",
        "to": "camoufox",
        "filter": [
          "**/*",
          "!**/*.pyc",
          "!**/__pycache__/**",
          "!**/.venv/**",
          "!tests/**"
        ]
      },
      {
        "from": "resources/icon.ico",
        "to": "assets/icon.ico"
      },
      {
        "from": "E:/BossClaw-build/assets/bridge",
        "to": "bridge"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BossClaw"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Office",
      "maintainer": "YanQuan <yanquan@bossclaw.dev>",
      "synopsis": "BossClaw 求职投递助手",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "electron/preload/**",
      "**/*.node",
      "**/*.exe",
      "**/*.dll",
      "**/*.so",
      "**/*.dylib"
    ],
    "beforePack": "build/before-pack.cjs",
    "npmRebuild": false
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.21.6",
    "cloakbrowser": "^0.5.7",
    "mammoth": "^1.8.0",
    "playwright-core": "1.62",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^42.11.10",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "esbuild": "0.21.5"
  }
}
